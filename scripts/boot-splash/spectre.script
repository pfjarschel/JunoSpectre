// Juno Spectre boot splash: splash.png scaled to cover the screen, centred
// (the same picture and crop as the app splash, so the handover is seamless).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

picture = Image("splash.png");
sw = Window.GetWidth();
sh = Window.GetHeight();
scale = Math.Max(sw / picture.GetWidth(), sh / picture.GetHeight());
scaled = picture.Scale(Math.Int(picture.GetWidth() * scale + 0.5), Math.Int(picture.GetHeight() * scale + 0.5));

splash = Sprite(scaled);
splash.SetX(Window.GetX() + Math.Int((sw - scaled.GetWidth()) / 2));
splash.SetY(Window.GetY() + Math.Int((sh - scaled.GetHeight()) / 2));
splash.SetZ(0);
